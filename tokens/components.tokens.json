{
  "$description": "Component-level aliases. Platform repos may map these to native controls, but this repo only emits generic tokens.",
  "component": {
    "button": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{color.brand.yellow}",
          "$description": "Primary command background.",
          "$extensions": {
            "putio": {
              "cssName": "button-primary-bg",
              "mode": "global"
            }
          }
        },
        "backgroundHover": {
          "$type": "color",
          "$value": "{color.yellow.light.solidHover}",
          "$description": "Primary command hover background in light mode.",
          "$extensions": {
            "putio": {
              "cssName": "button-primary-bg-hover",
              "mode": "light"
            }
          }
        },
        "backgroundHoverDark": {
          "$type": "color",
          "$value": "{color.yellow.dark.solidHover}",
          "$description": "Primary command hover background in dark mode.",
          "$extensions": {
            "putio": {
              "cssName": "button-primary-bg-hover",
              "mode": "dark"
            }
          }
        },
        "foreground": {
          "$type": "color",
          "$value": "{component.alias.primaryForeground}",
          "$description": "Text or icon color on the yellow primary button.",
          "$extensions": {
            "putio": {
              "cssName": "button-primary-fg",
              "mode": "global"
            }
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.default}",
          "$extensions": {
            "putio": {
              "cssName": "button-radius",
              "mode": "global"
