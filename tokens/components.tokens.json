{
  "$description": "Component-level aliases. Platform repos may map these to native controls, but this repo only emits generic tokens.",
  "component": {
    "button": {
      "primary": {
        "background": {
          "$type": "color",
          "$value": "{color.brand.yellow}",
          "$description": "Primary command background.",
          "$extensions": {
            "putio": {
              "cssName": "button-primary-bg",
              "mode": "global"
            }
          }
        },
        "foreground": {
          "$type": "color",
          "$value": "#0A0A0A",
          "$description": "Text or icon color on the yellow primary button.",
          "$extensions": {
            "putio": {
              "cssName": "button-primary-fg",
              "mode": "global"
            }
          }
        },
        "radius": {
          "$type": "dimension",
          "$value": "{radius.default}",
          "$extensions": {
            "putio": {
              "cssName": "button-radius",
              "mode": "global"
            }
          }
        }
      },
      "secondary": {
        "background": {
          "$type": "color",
          "$value": "{color.neutral.light.componentBg}",
          "$extensions": {
            "putio": {
              "cssName": "button-secondary-bg",
              "mode": "light"
            }
          }
        },
        "backgroundDark": {
          "$type": "color",
          "$value": "{color.neutral.dark.componentBg}",
          "$extensions": {
            "putio": {
              "cssName": "button-secondary-bg",
              "mode": "dark"
            }
          }
        },
        "foreground": {
          "$type": "color",
          "$value": "{color.neutral.light.text}",
          "$extensions": {
            "putio": {
              "cssName": "button-secondary-fg",
              "mode": "light"
            }
          }
        },
        "foregroundDark": {
          "$type": "color",
          "$value": "{color.neutral.dark.text}",
          "$extensions": {
            "putio": {
              "cssName": "button-secondary-fg",
              "mode": "dark"
            }
          }
        }
      }
    },
    "input": {
      "background": {
        "$type": "color",
        "$value": "{surface.light.appBg}",
        "$extensions": {
          "putio": {
            "cssName": "input-bg",
            "mode": "light"
          }
        }
      },
      "backgroundDark": {
        "$type": "color",
        "$value": "{color.neutral.dark.componentBg}",
        "$extensions": {
          "putio": {
            "cssName": "input-bg",
            "mode": "dark"
          }
        }
      },
      "border": {
        "$type": "color",
        "$value": "{color.neutral.light.border}",
        "$extensions": {
          "putio": {
            "cssName": "input-border",
            "mode": "light"
          }
        }
      },
      "borderDark": {
        "$type": "color",
        "$value": "{color.neutral.dark.border}",
        "$extensions": {
          "putio": {
            "cssName": "input-border",
            "mode": "dark"
          }
        }
      },
      "radius": {
        "$type": "dimension",
        "$value": "{radius.default}",
        "$extensions": {
          "putio": {
            "cssName": "input-radius",
            "mode": "global"
          }
        }
      }
    },
    "fileRow": {
      "background": {
        "$type": "color",
        "$value": "{surface.light.listItemBg}",
        "$extensions": {
          "putio": {
            "cssName": "file-row-bg",
            "mode": "light"
          }
        }
      },
      "backgroundDark": {
        "$type": "color",
        "$value": "{surface.dark.listItemBg}",
        "$extensions": {
          "putio": {
            "cssName": "file-row-bg",
            "mode": "dark"
          }
        }
      },
      "hoverBackground": {
        "$type": "color",
        "$value": "{surface.light.listItemBgHover}",
        "$extensions": {
          "putio": {
            "cssName": "file-row-bg-hover",
            "mode": "light"
          }
        }
      },
      "hoverBackgroundDark": {
        "$type": "color",
        "$value": "{surface.dark.listItemBgHover}",
        "$extensions": {
          "putio": {
            "cssName": "file-row-bg-hover",
            "mode": "dark"
          }
        }
      },
      "icon": {
        "$type": "color",
        "$value": "{color.brand.yellow}",
        "$extensions": {
          "putio": {
            "cssName": "file-row-icon",
            "mode": "global"
          }
        }
      }
    },
    "notification": {
      "infoBackground": {
        "$type": "color",
        "$value": "{color.neutral.light.bgSecondary}",
        "$extensions": {
          "putio": {
            "cssName": "notification-info-bg",
            "mode": "light"
          }
        }
      },
      "infoBackgroundDark": {
        "$type": "color",
        "$value": "{color.neutral.dark.componentBg}",
        "$extensions": {
          "putio": {
            "cssName": "notification-info-bg",
            "mode": "dark"
          }
        }
      },
      "dangerBackground": {
        "$type": "color",
        "$value": "{color.red.light.componentBg}",
        "$extensions": {
          "putio": {
            "cssName": "notification-danger-bg",
            "mode": "light"
          }
        }
      },
      "dangerBackgroundDark": {
        "$type": "color",
        "$value": "{color.red.dark.componentBg}",
        "$extensions": {
          "putio": {
            "cssName": "notification-danger-bg",
            "mode": "dark"
          }
        }
      }
    }
  }
}
