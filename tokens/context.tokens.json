{
  "$description": "Shared TV context tokens. Consuming TV repos generate their own platform artifacts from these values.",
  "context": {
    "tv": {
      "surface": {
        "0": {
          "$type": "color",
          "$value": "hsl(0, 0%, 0%)",
          "$extensions": {
            "putio": {
              "cssName": "surf-0",
              "mode": "tv"
            }
          }
        },
        "1": {
          "$type": "color",
          "$value": "hsl(0, 0%, 3.9%)",
          "$extensions": {
            "putio": {
              "cssName": "surf-1",
              "mode": "tv"
            }
          }
        },
        "2": {
          "$type": "color",
          "$value": "hsl(0, 0%, 8.6%)",
          "$extensions": {
            "putio": {
              "cssName": "surf-2",
              "mode": "tv"
            }
          }
        },
        "3": {
          "$type": "color",
          "$value": "hsl(0, 0%, 12.2%)",
          "$extensions": {
            "putio": {
              "cssName": "surf-3",
              "mode": "tv"
            }
          }
        }
      },
      "text": {
        "primary": {
          "$type": "color",
          "$value": "hsl(0, 0%, 95.7%)",
          "$extensions": {
            "putio": {
              "cssName": "text-1",
              "mode": "tv"
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "hsla(0, 0%, 95.7%, 0.62)",
          "$extensions": {
            "putio": {
              "cssName": "text-2",
              "mode": "tv"
            }
          }
        },
        "tertiary": {
          "$type": "color",
          "$value": "hsla(0, 0%, 95.7%, 0.38)",
          "$extensions": {
            "putio": {
              "cssName": "text-3",
              "mode": "tv"
            }
          }
        }
      },
      "glass": {
        "1": {
          "$type": "color",
          "$value": "hsla(0, 0%, 100%, 0.06)",
          "$extensions": {
            "putio": {
              "cssName": "glass-1-bg",
              "mode": "tv"
            }
          }
        },
        "2": {
          "$type": "color",
          "$value": "hsla(0, 0%, 100%, 0.10)",
          "$extensions": {
            "putio": {
              "cssName": "glass-2-bg",
              "mode": "tv"
            }
          }
        },
        "3": {
          "$type": "color",
          "$value": "hsla(0, 0%, 100%, 0.14)",
          "$extensions": {
            "putio": {
              "cssName": "glass-3-bg",
              "mode": "tv"
            }
          }
        },
        "border": {
          "$type": "color",
          "$value": "hsla(0, 0%, 100%, 0.12)",
          "$extensions": {
            "putio": {
              "cssName": "glass-border",
              "mode": "tv"
            }
          }
        },
        "borderStrong": {
          "$type": "color",
          "$value": "hsla(0, 0%, 100%, 0.22)",
          "$extensions": {
            "putio": {
              "cssName": "glass-border-strong",
              "mode": "tv"
            }
          }
        }
      },
      "focus": {
        "ring": {
          "$type": "color",
          "$value": "hsla(44.7, 97.9%, 63.1%, 0.18)",
          "$extensions": {
            "putio": {
              "cssName": "focus-ring",
              "mode": "tv"
            }
          }
        },
        "liftShadow": {
          "$type": "string",
          "$value": "0 14px 30px hsla(0, 0%, 0%, 0.45)",
          "$extensions": {
            "putio": {
              "cssName": "focus-shadow",
              "mode": "tv"
            }
          }
        }
      },
      "channelArt": {
        "production": {
          "posterBackground": {
            "$type": "color",
            "$value": "hsl(0, 0%, 20%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-production-poster-bg",
                "mode": "tv"
              }
            }
          },
          "splashBackground": {
            "$type": "color",
            "$value": "{color.neutral.dark.bg}",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-production-splash-bg",
                "mode": "tv"
              }
            }
          }
        },
        "development": {
          "background": {
            "$type": "color",
            "$value": "hsl(206.7, 78.8%, 52%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-bg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "hsl(206.3, 100%, 81.2%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-accent",
                "mode": "tv"
              }
            }
          },
          "grid": {
            "$type": "color",
            "$value": "hsla(0, 0%, 100%, 0.18)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-grid",
                "mode": "tv"
              }
            }
          }
        },
        "lab": {
          "background": {
            "$type": "color",
            "$value": "hsl(120, 20%, 4.9%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-bg",
                "mode": "tv"
              }
            }
          },
          "foreground": {
            "$type": "color",
            "$value": "hsl(111.1, 100%, 94.7%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-fg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "hsl(110.6, 100%, 53.9%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-accent",
                "mode": "tv"
              }
            }
          }
        }
      }
    }
  }
}
