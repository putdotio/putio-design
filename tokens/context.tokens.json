{
  "$description": "Shared TV context tokens. Consuming TV repos generate their own platform artifacts from these values.",
  "context": {
    "tv": {
      "text": {
        "primary": {
          "$type": "color",
          "$value": "hsl(0, 0%, 95.7%)",
          "$extensions": {
            "putio": {
              "cssName": "text-1",
              "mode": "tv"
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "hsla(0, 0%, 95.7%, 0.62)",
          "$extensions": {
            "putio": {
              "cssName": "text-2",
              "mode": "tv"
            }
          }
        },
        "tertiary": {
          "$type": "color",
          "$value": "hsla(0, 0%, 95.7%, 0.38)",
          "$extensions": {
            "putio": {
              "cssName": "text-3",
              "mode": "tv"
            }
          }
        }
      },
      "channelArt": {
        "production": {
          "posterBackground": {
            "$type": "color",
            "$value": "hsl(0, 0%, 20%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-production-poster-bg",
                "mode": "tv"
              }
            }
          },
          "splashBackground": {
            "$type": "color",
            "$value": "{color.neutral.dark.bg}",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-production-splash-bg",
                "mode": "tv"
              }
            }
          }
        },
        "development": {
          "background": {
            "$type": "color",
            "$value": "hsl(206.7, 78.8%, 52%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-bg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "hsl(206.3, 100%, 81.2%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-accent",
                "mode": "tv"
              }
            }
          },
          "grid": {
            "$type": "color",
            "$value": "hsla(0, 0%, 100%, 0.18)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-grid",
                "mode": "tv"
              }
            }
          }
        },
        "lab": {
          "background": {
            "$type": "color",
            "$value": "hsl(120, 20%, 4.9%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-bg",
                "mode": "tv"
              }
            }
          },
          "foreground": {
            "$type": "color",
            "$value": "hsl(111.1, 100%, 94.7%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-fg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "hsl(110.6, 100%, 53.9%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-accent",
                "mode": "tv"
              }
            }
          }
        }
      }
    }
  },
  "tv": {
    "$description": "The 10-foot scale, mirroring apps/tv-native/src/lib/theme.tsx. These are mode \"tv\" tokens: they are graph data for native TV emitters and are not emitted into the web CSS, so preview support CSS declares the matching --tv-* properties under .tv. Two things do not fold into the web scales — TV has no mono face, and TV z-order is not the web z-order.",
    "text": {
      "heading": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "text.heading · GTAmerica-Md.",
        "$extensions": { "putio": { "cssName": "tv-text-heading", "mode": "tv" } }
      },
      "label": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "text.label · GTAmerica-Md. Screen titles, and the file-row icon size.",
        "$extensions": { "putio": { "cssName": "tv-text-label", "mode": "tv" } }
      },
      "body": {
        "$type": "dimension",
        "$value": "36px",
        "$description": "text.body · GTAmerica-Rg. The file-row title.",
        "$extensions": { "putio": { "cssName": "tv-text-body", "mode": "tv" } }
      },
      "caption": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "text.caption · GTAmerica-Rg. Row subline and button icons. TV has no mono face — the size subline renders in GT America with tabular figures, so the Berkeley Mono numeric rule is web and mobile only.",
        "$extensions": { "putio": { "cssName": "tv-text-caption", "mode": "tv" } }
      },
      "smol": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "text.smol · GTAmerica-Rg. Button labels, rendered uppercase.",
        "$extensions": { "putio": { "cssName": "tv-text-smol", "mode": "tv" } }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "400",
        "$description": "GTAmerica-Rg.",
        "$extensions": { "putio": { "cssName": "tv-fw-regular", "mode": "tv" } }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500",
        "$description": "GTAmerica-Md.",
        "$extensions": { "putio": { "cssName": "tv-fw-medium", "mode": "tv" } }
      }
    },
    "space": {
      "xxs": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": { "putio": { "cssName": "tv-space-xxs", "mode": "tv" } }
      },
      "xs": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": { "putio": { "cssName": "tv-space-xs", "mode": "tv" } }
      },
      "sm": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Button padding at size=\"sm\".",
        "$extensions": { "putio": { "cssName": "tv-space-sm", "mode": "tv" } }
      },
      "md": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "The workhorse step: uniform list-row padding, row gap, and header padding-bottom.",
        "$extensions": { "putio": { "cssName": "tv-space-md", "mode": "tv" } }
      },
      "lg": {
        "$type": "dimension",
        "$value": "64px",
        "$extensions": { "putio": { "cssName": "tv-space-lg", "mode": "tv" } }
      },
      "xl": {
        "$type": "dimension",
        "$value": "128px",
        "$extensions": { "putio": { "cssName": "tv-space-xl", "mode": "tv" } }
      },
      "xxl": {
        "$type": "dimension",
        "$value": "256px",
        "$extensions": { "putio": { "cssName": "tv-space-xxl", "mode": "tv" } }
      }
    },
    "overscan": {
      "x": {
        "$type": "dimension",
        "$value": "4%",
        "$description": "overscanSafeMargins.left/right — a fraction of viewport width (76.8px on a 1920-wide canvas). Native emitters resolve this against the viewport.",
        "$extensions": { "putio": { "cssName": "tv-overscan-x", "mode": "tv" } }
      },
      "y": {
        "$type": "dimension",
        "$value": "2%",
        "$description": "overscanSafeMargins.top/bottom — a fraction of viewport HEIGHT (21.6px on a 1080-tall canvas). CSS resolves percentage padding against width, so web previews must derive the vertical overscan explicitly rather than writing 2%.",
        "$extensions": { "putio": { "cssName": "tv-overscan-y", "mode": "tv" } }
      }
    },
    "screen": {
      "paddingX": {
        "$type": "dimension",
        "$value": "{tv.overscan.x}",
        "$description": "screen.header.paddingLeft/Right — the screen gutter is the overscan margin itself. 76.8px on a 1920-wide canvas.",
        "$extensions": { "putio": { "cssName": "tv-screen-padding-x", "mode": "tv" } }
      },
      "headerPaddingTop": {
        "$type": "dimension",
        "$value": "calc({tv.space.md} + {tv.overscan.y})",
        "$description": "screen.header.paddingTop — space.md plus the top overscan margin. Resolves to 53.6px on a 1920×1080 canvas. The percentage is of viewport HEIGHT, so native emitters must compute it against the viewport rather than passing the calc() through to CSS.",
        "$extensions": { "putio": { "cssName": "tv-screen-header-padding-top", "mode": "tv" } }
      },
      "headerPaddingBottom": {
        "$type": "dimension",
        "$value": "{tv.space.md}",
        "$description": "screen.header.paddingBottom = space.md, viewport-independent.",
        "$extensions": { "putio": { "cssName": "tv-screen-header-padding-bottom", "mode": "tv" } }
      },
      "marginTop": {
        "$type": "dimension",
        "$value": "{tv.space.md}",
        "$description": "screen.marginTop = space.md, viewport-independent.",
        "$extensions": { "putio": { "cssName": "tv-screen-margin-top", "mode": "tv" } }
      },
      "marginBottom": {
        "$type": "dimension",
        "$value": "calc({tv.space.md} + {tv.overscan.y})",
        "$description": "screen.marginBottom — space.md plus the bottom overscan margin. Resolves to 53.6px on a 1920×1080 canvas; the percentage is of viewport height.",
        "$extensions": { "putio": { "cssName": "tv-screen-margin-bottom", "mode": "tv" } }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.tv}",
      "$description": "radii.default — one radius for every 10-foot surface.",
      "$extensions": { "putio": { "cssName": "tv-radius", "mode": "tv" } }
    },
    "z": {
      "$description": "zIndices. NOT the web --z-* order: on TV, overlay sits ABOVE toast. Emit the two scales separately and never fold TV into the web stack order.",
      "modal": {
        "$type": "number",
        "$value": 100,
        "$extensions": { "putio": { "cssName": "tv-z-modal", "mode": "tv", "category": "other" } }
      },
      "toast": {
        "$type": "number",
        "$value": 200,
        "$extensions": { "putio": { "cssName": "tv-z-toast", "mode": "tv", "category": "other" } }
      },
      "overlay": {
        "$type": "number",
        "$value": 300,
        "$description": "Above toast — the opposite of the web scale, where --z-notification (1400) sits above --z-modal (1300).",
        "$extensions": { "putio": { "cssName": "tv-z-overlay", "mode": "tv", "category": "other" } }
      }
    }
  }
}
