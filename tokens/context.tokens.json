{
  "$description": "Shared TV context tokens. Consuming TV repos generate their own platform artifacts from these values.",
  "context": {
    "tv": {
      "text": {
        "$description": "TV uses two semantic text roles. The tertiary name remains as a deprecated alias of secondary so existing consumers keep working; TV text is solid.",
        "primary": {
          "$type": "color",
          "$value": "{color.neutral.dark.text}",
          "$description": "Row titles, modal option labels, and button labels.",
          "$extensions": {
            "putio": {
              "cssName": "text-1",
              "mode": "tv"
            }
          }
        },
        "secondary": {
          "$type": "color",
          "$value": "{color.neutral.dark.textSecondary}",
          "$description": "Row sublines, modal titles, section headers, and accessories.",
          "$extensions": {
            "putio": {
              "cssName": "text-2",
              "mode": "tv"
            }
          }
        },
        "tertiary": {
          "$type": "color",
          "$value": "{context.tv.text.secondary}",
          "$description": "Deprecated compatibility alias. Use context.tv.text.secondary.",
          "$extensions": {
            "putio": {
              "cssName": "text-3",
              "mode": "tv",
              "deprecated": true
            }
          }
        }
      },
      "channelArt": {
        "production": {
          "posterBackground": {
            "$type": "color",
            "$value": "hsl(0, 0%, 20%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-production-poster-bg",
                "mode": "tv"
              }
            }
          },
          "splashBackground": {
            "$type": "color",
            "$value": "{color.neutral.dark.bg}",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-production-splash-bg",
                "mode": "tv"
              }
            }
          }
        },
        "development": {
          "background": {
            "$type": "color",
            "$value": "hsl(206.7, 78.8%, 52%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-bg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "hsl(206.3, 100%, 81.2%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-accent",
                "mode": "tv"
              }
            }
          },
          "grid": {
            "$type": "color",
            "$value": "hsla(0, 0%, 100%, 0.18)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-development-grid",
                "mode": "tv"
              }
            }
          }
        },
        "nightly": {
          "$description": "Nightly/staging store-art flavor: TestFlight, Play internal/closed tracks, and staging TV sideloads. True-black sky with scattered stars; the mark stays exactly as production draws it, so the surface alone carries the flavor.",
          "background": {
            "$type": "color",
            "$value": "hsl(0, 0%, 2%)",
            "$description": "True black, one step past production charcoal; carries the star field so a staging build is unmistakable next to the shipping app.",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-nightly-bg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "{color.brand.yellow}",
            "$description": "Unlike dev, nightly does not recolor the mark: the accent is the brand yellow and the retro wordmark keeps its yellow drop-shadow. Present so emitters can express the flavor as a complete set rather than a special case.",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-nightly-accent",
                "mode": "tv"
              }
            }
          },
          "star": {
            "$type": "color",
            "$value": "hsl(0, 0%, 100%)",
            "$description": "Star colour. Stars are scattered, never gridded: three sizes at roughly 36%, 62%, and 95% opacity with the faint ones dominating. Static — never animated, blurred, or glowing.",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-nightly-star",
                "mode": "tv"
              }
            }
          },
          "moon": {
            "$type": "color",
            "$value": "{color.brand.yellow}",
            "$description": "Full moon disc in the brand yellow, placed top-left. Its own token so a platform can place the moon without hard-coding the brand value.",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-nightly-moon",
                "mode": "tv"
              }
            }
          },
          "moonCrater": {
            "$type": "color",
            "$value": "hsl(45, 82%, 56%)",
            "$description": "Craters one step darker than the moon disc. Low contrast on purpose: texture at icon size, not holes.",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-nightly-moon-crater",
                "mode": "tv"
              }
            }
          }
        },
        "lab": {
          "background": {
            "$type": "color",
            "$value": "hsl(120, 20%, 4.9%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-bg",
                "mode": "tv"
              }
            }
          },
          "foreground": {
            "$type": "color",
            "$value": "hsl(111.1, 100%, 94.7%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-fg",
                "mode": "tv"
              }
            }
          },
          "accent": {
            "$type": "color",
            "$value": "hsl(110.6, 100%, 53.9%)",
            "$extensions": {
              "putio": {
                "cssName": "tv-channel-art-lab-accent",
                "mode": "tv"
              }
            }
          }
        }
      }
    }
  },
  "tv": {
    "$description": "The portable 10-foot scale. These mode \"tv\" tokens are graph data for platform adapters and are not emitted into web CSS; preview support CSS declares matching --tv-* properties under .tv. TV has no mono face, and its z-order is distinct from the web stack.",
    "video": {
      "$description": "On-video and hero-art plate colors. Fixed values by design: the video underneath does not change with the theme.",
      "background": {
        "$type": "color",
        "$value": "hsl(0, 0%, 0%)",
        "$description": "Letterbox / video plate. True black, not the app background.",
        "$extensions": { "putio": { "cssName": "tv-video-bg", "mode": "tv" } }
      },
      "heroScrimTop": {
        "$type": "color",
        "$value": "hsl(30, 18.2%, 8.6%)",
        "$description": "Top stop of the warm-black wash behind hero/poster art.",
        "$extensions": { "putio": { "cssName": "tv-hero-scrim-top", "mode": "tv" } }
      },
      "heroScrimBottom": {
        "$type": "color",
        "$value": "hsl(30, 25%, 1.6%)",
        "$description": "Bottom stop of the hero wash. Near-black but warm — never pure black, which reads blue next to the art.",
        "$extensions": { "putio": { "cssName": "tv-hero-scrim-bottom", "mode": "tv" } }
      },
      "textOnVideo": {
        "$type": "color",
        "$value": "hsl(0, 0%, 100%)",
        "$description": "Player chrome over video — always white, never a theme token.",
        "$extensions": { "putio": { "cssName": "tv-text-on-video", "mode": "tv" } }
      }
    },
    "text": {
      "heading": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "text.heading · GTAmerica-Md.",
        "$extensions": { "putio": { "cssName": "tv-text-heading", "mode": "tv" } }
      },
      "label": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "text.label · GTAmerica-Md. Screen titles, and the file-row icon size.",
        "$extensions": { "putio": { "cssName": "tv-text-label", "mode": "tv" } }
      },
      "body": {
        "$type": "dimension",
        "$value": "36px",
        "$description": "text.body · GTAmerica-Rg. The file-row title.",
        "$extensions": { "putio": { "cssName": "tv-text-body", "mode": "tv" } }
      },
      "caption": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "text.caption · GTAmerica-Rg. Row subline and button icons. TV has no mono face, so the Berkeley Mono numeric rule is web and mobile only: the size subline renders in GT America, asking for its tnum tabular figures where the platform can select OpenType features and accepting proportional figures where it cannot.",
        "$extensions": { "putio": { "cssName": "tv-text-caption", "mode": "tv" } }
      },
      "smol": {
        "$type": "dimension",
        "$value": "24px",
        "$description": "text.smol · GTAmerica-Rg. Button labels, rendered uppercase.",
        "$extensions": { "putio": { "cssName": "tv-text-smol", "mode": "tv" } }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "400",
        "$description": "GTAmerica-Rg.",
        "$extensions": { "putio": { "cssName": "tv-fw-regular", "mode": "tv" } }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500",
        "$description": "GTAmerica-Md.",
        "$extensions": { "putio": { "cssName": "tv-fw-medium", "mode": "tv" } }
      }
    },
    "space": {
      "xxs": {
        "$type": "dimension",
        "$value": "4px",
        "$extensions": { "putio": { "cssName": "tv-space-xxs", "mode": "tv" } }
      },
      "xs": {
        "$type": "dimension",
        "$value": "8px",
        "$extensions": { "putio": { "cssName": "tv-space-xs", "mode": "tv" } }
      },
      "sm": {
        "$type": "dimension",
        "$value": "16px",
        "$description": "Button padding at size=\"sm\".",
        "$extensions": { "putio": { "cssName": "tv-space-sm", "mode": "tv" } }
      },
      "md": {
        "$type": "dimension",
        "$value": "32px",
        "$description": "The workhorse step: uniform list-row padding, row gap, and header padding-bottom.",
        "$extensions": { "putio": { "cssName": "tv-space-md", "mode": "tv" } }
      },
      "lg": {
        "$type": "dimension",
        "$value": "64px",
        "$extensions": { "putio": { "cssName": "tv-space-lg", "mode": "tv" } }
      },
      "xl": {
        "$type": "dimension",
        "$value": "128px",
        "$extensions": { "putio": { "cssName": "tv-space-xl", "mode": "tv" } }
      },
      "xxl": {
        "$type": "dimension",
        "$value": "256px",
        "$extensions": { "putio": { "cssName": "tv-space-xxl", "mode": "tv" } }
      }
    },
    "overscan": {
      "x": {
        "$type": "number",
        "$value": 0.04,
        "$description": "Horizontal safe-area ratio. Platform adapters multiply this value by viewport width.",
        "$extensions": { "putio": { "cssName": "tv-overscan-x", "mode": "tv", "basis": "viewport-width" } }
      },
      "y": {
        "$type": "number",
        "$value": 0.02,
        "$description": "Vertical safe-area ratio. Platform adapters multiply this value by viewport height.",
        "$extensions": { "putio": { "cssName": "tv-overscan-y", "mode": "tv", "basis": "viewport-height" } }
      }
    },
    "radius": {
      "$type": "dimension",
      "$value": "{radius.tv}",
      "$description": "radii.default — one radius for every 10-foot surface.",
      "$extensions": { "putio": { "cssName": "tv-radius", "mode": "tv" } }
    },
    "z": {
      "$description": "zIndices. NOT the web --z-* order: on TV, overlay sits ABOVE toast. Emit the two scales separately and never fold TV into the web stack order.",
      "modal": {
        "$type": "number",
        "$value": 100,
        "$extensions": { "putio": { "cssName": "tv-z-modal", "mode": "tv", "category": "other" } }
      },
      "toast": {
        "$type": "number",
        "$value": 200,
        "$extensions": { "putio": { "cssName": "tv-z-toast", "mode": "tv", "category": "other" } }
      },
      "overlay": {
        "$type": "number",
        "$value": 300,
        "$description": "Above toast — the opposite of the web scale, where --z-notification (1400) sits above --z-modal (1300).",
        "$extensions": { "putio": { "cssName": "tv-z-overlay", "mode": "tv", "category": "other" } }
      }
    }
  }
}
