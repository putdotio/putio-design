        }
      },
      "inOut": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)",
        "$extensions": {
          "putio": {
            "cssName": "ease-in-out",
            "mode": "global",
            "figma": true
          }
        }
