      "$value": "16px",
      "$extensions": {
        "putio": {
          "cssName": "space-3",
          "mode": "global",
          "figma": true
        }
      }
    },
    "4": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "putio": {
          "cssName": "space-4",
          "mode": "global",
          "figma": true
        }
      }
    },
    "5": {
      "$type": "dimension",
      "$value": "64px",
      "$extensions": {
        "putio": {
          "cssName": "space-5",
          "mode": "global",
