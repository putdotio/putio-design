  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "putio": {
          "cssName": "radius-sm",
          "mode": "global",
          "figma": true
        }
      }
    },
    "default": {
      "$type": "dimension",
      "$value": "6px",
      "$extensions": {
        "putio": {
          "cssName": "radius",
          "mode": "global",
          "figma": true
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "putio": {
          "cssName": "radius-md",
          "mode": "global",
          "figma": true
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "10px",
      "$extensions": {
        "putio": {
          "cssName": "radius-lg",
          "mode": "global",
