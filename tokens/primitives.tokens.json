        "$value": "1.125rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-lg",
            "mode": "global",
            "figma": true
          }
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "2rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-2xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "3xl": {
        "$type": "dimension",
        "$value": "3rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-3xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "4xl": {
        "$type": "dimension",
        "$value": "4rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-4xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "display": {
        "$type": "dimension",
        "$value": "6rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-display",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": "1.1",
        "$extensions": {
          "putio": {
            "cssName": "lh-tight",
            "mode": "global",
            "figma": true
          }
        }
      },
      "snug": {
        "$type": "number",
        "$value": "1.25",
        "$extensions": {
          "putio": {
            "cssName": "lh-snug",
            "mode": "global",
            "figma": true
          }
        }
      },
      "normal": {
        "$type": "number",
        "$value": "1.45",
        "$extensions": {
          "putio": {
            "cssName": "lh-normal",
            "mode": "global",
            "figma": true
          }
        }
      },
      "loose": {
        "$type": "number",
        "$value": "1.6",
        "$extensions": {
          "putio": {
            "cssName": "lh-loose",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "400",
        "$extensions": {
          "putio": {
            "cssName": "fw-regular",
            "mode": "global",
            "figma": true
          }
        }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500",
        "$extensions": {
          "putio": {
            "cssName": "fw-medium",
            "mode": "global",
            "figma": true
          }
        }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "700",
        "$extensions": {
          "putio": {
            "cssName": "fw-bold",
            "mode": "global",
            "figma": true
