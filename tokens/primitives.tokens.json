{
  "$description": "Primitive put.io design tokens. These are the values other token groups reference.",
  "color": {
    "brand": {
      "yellow": {
        "$type": "color",
        "$value": "hsl(44.7, 97.9%, 63.1%)",
        "$description": "put.io brand yellow (canonical hex #FDCE45). The resting brand fill is the same in light and dark modes.",
        "$extensions": {
          "putio": {
            "cssName": "yellow-solid",
            "mode": "global",
            "figma": true
          }
        }
      }
    }
  },
  "elevation": {
    "shadowColor": {
      "$type": "color",
      "$value": "hsl(0, 0%, 78.0%)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-color",
          "mode": "global",
          "figma": true
        }
      }
    },
    "color": {
      "$type": "color",
      "$value": "{elevation.shadowColor}",
      "$description": "Compat name kept for existing web consumers — alias of elevation.shadowColor so the two can never drift.",
      "$extensions": {
        "putio": {
          "cssName": "shadow",
          "mode": "global",
          "figma": true
        }
      }
    },
    "sm": {
      "$type": "string",
      "$value": "0 1px 2px hsla(0, 0%, 0%, 0.05)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-sm",
          "mode": "global",
          "figma": false
        }
      }
    },
    "md": {
      "$type": "string",
      "$value": "0 4px 12px hsla(0, 0%, 0%, 0.08)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-md",
          "mode": "global",
          "figma": false
        }
      }
    },
    "lg": {
      "$type": "string",
      "$value": "0 16px 40px hsla(0, 0%, 0%, 0.12)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-lg",
          "mode": "global",
          "figma": false
        }
      }
    },
    "focusColor": {
      "$type": "color",
      "$value": "hsla(47, 100%, 65%, 0.35)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-focus-color",
          "mode": "global",
          "figma": true
        }
      }
    },
    "focus": {
      "$type": "string",
      "$value": "0 0 0 3px {elevation.focusColor}",
      "$extensions": {
        "putio": {
          "cssName": "shadow-focus",
          "mode": "global",
          "figma": false
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"GT America\", sans-serif",
        "$extensions": {
          "putio": {
            "cssName": "font-sans",
            "mode": "global",
            "figma": true
          }
        }
      },
      "display": {
        "$type": "fontFamily",
        "$value": "{typography.fontFamily.sans}",
        "$extensions": {
          "putio": {
            "cssName": "font-display",
            "mode": "global",
            "figma": true
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "\"Berkeley Mono\", monospace",
        "$description": "The single mono face: numerics, timestamps, file sizes, ETAs, counts, code, logs, magnet URIs, identifiers, and filenames. Web and mobile only — TV has no mono face.",
        "$extensions": {
          "putio": {
            "cssName": "font-mono",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "fontSize": {
      "xs": {
        "$type": "dimension",
        "$value": "0.75rem",
        "$extensions": {
          "putio": {
            "cssName": "fs-xs",
            "mode": "global",
            "figma": true
          }
        }
      },
      "sm": {
        "$type": "dimension",
        "$value": "0.875rem",
        "$description": "Caption and button labels — production fontSize 0.",
        "$extensions": {
          "putio": {
            "cssName": "fs-sm",
            "mode": "global",
            "figma": true
          }
        }
      },
      "base": {
        "$type": "dimension",
        "$value": "1rem",
        "$description": "Body, labels, inputs — production fontSize 1; equals the responsive root (14px, 15px at >= breakpoint.lg).",
        "$extensions": {
          "putio": {
            "cssName": "fs-base",
            "mode": "global",
            "figma": true
          }
        }
      },
      "md": {
        "$type": "dimension",
        "$value": "1.125rem",
        "$description": "Subheading.",
        "$extensions": {
          "putio": {
            "cssName": "fs-md",
            "mode": "global",
            "figma": true
          }
        }
      },
      "lg": {
        "$type": "dimension",
        "$value": "1.5rem",
        "$description": "Heading.",
        "$extensions": {
          "putio": {
            "cssName": "fs-lg",
            "mode": "global",
            "figma": true
          }
        }
      },
      "xl": {
        "$type": "dimension",
        "$value": "2rem",
        "$description": "Page title.",
        "$extensions": {
          "putio": {
            "cssName": "fs-xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "2xl": {
        "$type": "dimension",
        "$value": "48px",
        "$description": "Fixed display tier — does not scale with the responsive root.",
        "$extensions": {
          "putio": {
            "cssName": "fs-2xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "3xl": {
        "$type": "dimension",
        "$value": "64px",
        "$description": "Fixed display tier — does not scale with the responsive root.",
        "$extensions": {
          "putio": {
            "cssName": "fs-3xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "4xl": {
        "$type": "dimension",
        "$value": "{typography.fontSize.3xl}",
        "$description": "Compatibility alias for the former 4xl tier; new surfaces should use fontSize.3xl or fontSize.display.",
        "$extensions": {
          "putio": {
            "cssName": "fs-4xl",
            "mode": "global",
            "figma": true
          }
        }
      },
      "display": {
        "$type": "dimension",
        "$value": "96px",
        "$description": "Fixed display tier for brand display moments.",
        "$extensions": {
          "putio": {
            "cssName": "fs-display",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "lineHeight": {
      "tight": {
        "$type": "number",
        "$value": "1.1",
        "$extensions": {
          "putio": {
            "cssName": "lh-tight",
            "mode": "global",
            "figma": true
          }
        }
      },
      "snug": {
        "$type": "number",
        "$value": "1.25",
        "$extensions": {
          "putio": {
            "cssName": "lh-snug",
            "mode": "global",
            "figma": true
          }
        }
      },
      "normal": {
        "$type": "number",
        "$value": "1.45",
        "$extensions": {
          "putio": {
            "cssName": "lh-normal",
            "mode": "global",
            "figma": true
          }
        }
      },
      "loose": {
        "$type": "number",
        "$value": "1.6",
        "$extensions": {
          "putio": {
            "cssName": "lh-loose",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "fontWeight": {
      "regular": {
        "$type": "fontWeight",
        "$value": "400",
        "$extensions": {
          "putio": {
            "cssName": "fw-regular",
            "mode": "global",
            "figma": true
          }
        }
      },
      "medium": {
        "$type": "fontWeight",
        "$value": "500",
        "$extensions": {
          "putio": {
            "cssName": "fw-medium",
            "mode": "global",
            "figma": true
          }
        }
      },
      "bold": {
        "$type": "fontWeight",
        "$value": "700",
        "$extensions": {
          "putio": {
            "cssName": "fw-bold",
            "mode": "global",
            "figma": true
          }
        }
      },
      "black": {
        "$type": "fontWeight",
        "$value": "900",
        "$extensions": {
          "putio": {
            "cssName": "fw-black",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "letterSpacing": {
      "tight": {
        "$type": "dimension",
        "$value": "-0.02em",
        "$extensions": {
          "putio": {
            "cssName": "tracking-tight",
            "mode": "global",
            "figma": true
          }
        }
      },
      "normal": {
        "$type": "number",
        "$value": "0",
        "$extensions": {
          "putio": {
            "cssName": "tracking-normal",
            "mode": "global",
            "figma": true
          }
        }
      },
      "wide": {
        "$type": "dimension",
        "$value": "0.02em",
        "$extensions": {
          "putio": {
            "cssName": "tracking-wide",
            "mode": "global",
            "figma": true
          }
        }
      },
      "uppercase": {
        "$type": "dimension",
        "$value": "0.08em",
        "$extensions": {
          "putio": {
            "cssName": "tracking-uppercase",
            "mode": "global",
            "figma": true
          }
        }
      }
    }
  },
  "spacing": {
    "0": {
      "$type": "dimension",
      "$value": "0",
      "$extensions": {
        "putio": {
          "cssName": "space-0",
          "mode": "global",
          "figma": true
        }
      }
    },
    "1": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "putio": {
          "cssName": "space-1",
          "mode": "global",
          "figma": true
        }
      }
    },
    "2": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "putio": {
          "cssName": "space-2",
          "mode": "global",
          "figma": true
        }
      }
    },
    "3": {
      "$type": "dimension",
      "$value": "16px",
      "$extensions": {
        "putio": {
          "cssName": "space-3",
          "mode": "global",
          "figma": true
        }
      }
    },
    "4": {
      "$type": "dimension",
      "$value": "32px",
      "$extensions": {
        "putio": {
          "cssName": "space-4",
          "mode": "global",
          "figma": true
        }
      }
    },
    "5": {
      "$type": "dimension",
      "$value": "64px",
      "$extensions": {
        "putio": {
          "cssName": "space-5",
          "mode": "global",
          "figma": true
        }
      }
    },
    "6": {
      "$type": "dimension",
      "$value": "128px",
      "$extensions": {
        "putio": {
          "cssName": "space-6",
          "mode": "global",
          "figma": true
        }
      }
    },
    "7": {
      "$type": "dimension",
      "$value": "256px",
      "$extensions": {
        "putio": {
          "cssName": "space-7",
          "mode": "global",
          "figma": true
        }
      }
    },
    "8": {
      "$type": "dimension",
      "$value": "512px",
      "$extensions": {
        "putio": {
          "cssName": "space-8",
          "mode": "global",
          "figma": true
        }
      }
    }
  },
  "radius": {
    "sm": {
      "$type": "dimension",
      "$value": "4px",
      "$extensions": {
        "putio": {
          "cssName": "radius-sm",
          "mode": "global",
          "figma": true
        }
      }
    },
    "default": {
      "$type": "dimension",
      "$value": "6px",
      "$extensions": {
        "putio": {
          "cssName": "radius",
          "mode": "global",
          "figma": true
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "8px",
      "$extensions": {
        "putio": {
          "cssName": "radius-md",
          "mode": "global",
          "figma": true
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "10px",
      "$extensions": {
        "putio": {
          "cssName": "radius-lg",
          "mode": "global",
          "figma": true
        }
      }
    },
    "pill": {
      "$type": "dimension",
      "$value": "999px",
      "$extensions": {
        "putio": {
          "cssName": "radius-pill",
          "mode": "global",
          "figma": true
        }
      }
    },
    "tv": {
      "$type": "dimension",
      "$value": "12px",
      "$description": "The corner radius for every 10-foot surface — list rows, buttons, sheets, cards, code tiles, keys. Mirrors apps/tv-native theme radii.default. TV uses one radius, not a scale; the only other radii on TV are intentional 999px pills and circles.",
      "$extensions": {
        "putio": {
          "cssName": "radius-tv",
          "mode": "global",
          "figma": true
        }
      }
    }
  },
  "border": {
    "width": {
      "$type": "dimension",
      "$value": "1px",
      "$extensions": {
        "putio": {
          "cssName": "border-width",
          "mode": "global",
          "figma": true
        }
      }
    }
  },
  "motion": {
    "easing": {
      "out": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.22, 1, 0.36, 1)",
        "$extensions": {
          "putio": {
            "cssName": "ease-out",
            "mode": "global",
            "figma": true
          }
        }
      },
      "inOut": {
        "$type": "cubicBezier",
        "$value": "cubic-bezier(0.65, 0, 0.35, 1)",
        "$extensions": {
          "putio": {
            "cssName": "ease-in-out",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "duration": {
      "fast": {
        "$type": "duration",
        "$value": "120ms",
        "$extensions": {
          "putio": {
            "cssName": "dur-fast",
            "mode": "global",
            "figma": true
          }
        }
      },
      "base": {
        "$type": "duration",
        "$value": "200ms",
        "$extensions": {
          "putio": {
            "cssName": "dur-base",
            "mode": "global",
            "figma": true
          }
        }
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms",
        "$extensions": {
          "putio": {
            "cssName": "dur-slow",
            "mode": "global",
            "figma": true
          }
        }
      }
    }
  },
  "z": {
    "$description": "Stacking scale. Gapped for platform chrome — never invent z-index numbers in apps.",
    "dropdown": {
      "$type": "number",
      "$value": 1000,
      "$extensions": {
        "putio": {
          "cssName": "z-dropdown",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    },
    "sticky": {
      "$type": "number",
      "$value": 1100,
      "$extensions": {
        "putio": {
          "cssName": "z-sticky",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    },
    "modal": {
      "$type": "number",
      "$value": 1300,
      "$extensions": {
        "putio": {
          "cssName": "z-modal",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    },
    "notification": {
      "$type": "number",
      "$value": 1400,
      "$extensions": {
        "putio": {
          "cssName": "z-notification",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    },
    "tooltip": {
      "$type": "number",
      "$value": 1500,
      "$extensions": {
        "putio": {
          "cssName": "z-tooltip",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    }
  },
  "breakpoint": {
    "$description": "Responsive breakpoints, lifted from app.put.io's BREAKPOINTS. Generator-facing: CSS media queries cannot read custom properties, so emitters bind these as Tailwind screens, StyleX consts, or documented literals.",
    "sm": {
      "$type": "dimension",
      "$value": "640px",
      "$extensions": {
        "putio": {
          "cssName": "bp-sm",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    },
    "md": {
      "$type": "dimension",
      "$value": "768px",
      "$extensions": {
        "putio": {
          "cssName": "bp-md",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    },
    "lg": {
      "$type": "dimension",
      "$value": "1280px",
      "$description": "The root font-size steps from 14px to 15px at this width.",
      "$extensions": {
        "putio": {
          "cssName": "bp-lg",
          "mode": "global",
          "category": "other",
          "figma": false
        }
      }
    }
  }
}
