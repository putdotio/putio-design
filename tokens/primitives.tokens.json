{
  "$description": "Primitive put.io design tokens. These are the values other token groups reference.",
  "color": {
    "brand": {
      "yellow": {
        "$type": "color",
        "$value": "hsl(44.7, 97.9%, 63.1%)",
        "$description": "put.io brand yellow (canonical hex #FDCE45). The resting brand fill is the same in light and dark modes.",
        "$extensions": {
          "putio": {
            "cssName": "yellow-solid",
            "mode": "global",
            "figma": true
          }
        }
      }
    }
  },
  "elevation": {
    "shadowColor": {
      "$type": "color",
      "$value": "hsl(0, 0%, 78.0%)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-color",
          "mode": "global",
          "figma": true
        }
      }
    },
    "color": {
      "$type": "color",
      "$value": "hsl(0, 0%, 78.0%)",
      "$extensions": {
        "putio": {
          "cssName": "shadow",
          "mode": "global",
          "figma": true
        }
      }
    },
    "sm": {
      "$type": "string",
      "$value": "0 1px 2px hsla(0, 0%, 0%, 0.05)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-sm",
          "mode": "global",
          "figma": false
        }
      }
    },
    "md": {
      "$type": "string",
      "$value": "0 4px 12px hsla(0, 0%, 0%, 0.08)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-md",
          "mode": "global",
          "figma": false
        }
      }
    },
    "lg": {
      "$type": "string",
      "$value": "0 16px 40px hsla(0, 0%, 0%, 0.12)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-lg",
          "mode": "global",
          "figma": false
        }
      }
    },
    "focusColor": {
      "$type": "color",
      "$value": "hsla(47, 100%, 65%, 0.35)",
      "$extensions": {
        "putio": {
          "cssName": "shadow-focus-color",
          "mode": "global",
          "figma": true
        }
      }
    },
    "focus": {
      "$type": "string",
      "$value": "0 0 0 2px {elevation.focusColor}, 0 0 0 3.5px hsl(0, 0%, 9.0%)",
      "$description": "Focus ring: brand-yellow inner band + high-contrast text-color outer edge so the indicator clears WCAG 1.4.11 (3:1) on any surface. Light-mode edge.",
      "$extensions": {
        "putio": {
          "cssName": "shadow-focus",
          "mode": "light",
          "figma": false
        }
      }
    },
    "focusDark": {
      "$type": "string",
      "$value": "0 0 0 2px {elevation.focusColor}, 0 0 0 3.5px hsl(0, 0%, 93.0%)",
      "$description": "Dark-mode focus ring: brand-yellow inner band + high-contrast text-color outer edge (WCAG 1.4.11).",
      "$extensions": {
        "putio": {
          "cssName": "shadow-focus",
          "mode": "dark",
          "figma": false
        }
      }
    }
  },
  "typography": {
    "fontFamily": {
      "sans": {
        "$type": "fontFamily",
        "$value": "\"GT America\", sans-serif",
        "$extensions": {
          "putio": {
            "cssName": "font-sans",
            "mode": "global",
            "figma": true
          }
        }
      },
      "display": {
        "$type": "fontFamily",
        "$value": "\"GT America\", sans-serif",
        "$extensions": {
          "putio": {
            "cssName": "font-display",
            "mode": "global",
            "figma": true
          }
        }
      },
      "uiMono": {
        "$type": "fontFamily",
        "$value": "\"GT America Mono\", monospace",
        "$extensions": {
          "putio": {
            "cssName": "font-ui-mono",
            "mode": "global",
            "figma": true
          }
        }
      },
      "mono": {
        "$type": "fontFamily",
        "$value": "\"Berkeley Mono\", \"GT America Mono\", monospace",
        "$extensions": {
          "putio": {
            "cssName": "font-mono",
            "mode": "global",
            "figma": true
          }
        }
      }
    },
    "fontSize": {
