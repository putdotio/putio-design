        "$value": "120ms",
        "$extensions": {
          "putio": {
            "cssName": "dur-fast",
            "mode": "global",
            "figma": true
          }
        }
      },
      "base": {
        "$type": "duration",
        "$value": "200ms",
        "$extensions": {
          "putio": {
            "cssName": "dur-base",
            "mode": "global",
            "figma": true
          }
        }
      },
      "slow": {
        "$type": "duration",
        "$value": "320ms",
        "$extensions": {
          "putio": {
            "cssName": "dur-slow",
            "mode": "global",
            "figma": true
          }
        }
      }
    }
  }
}
