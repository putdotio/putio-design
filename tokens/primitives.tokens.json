    "letterSpacing": {
      "tight": {
        "$type": "dimension",
        "$value": "-0.02em",
        "$extensions": {
          "putio": {
            "cssName": "tracking-tight",
            "mode": "global",
            "figma": true
          }
        }
      },
      "normal": {
        "$type": "number",
        "$value": "0",
        "$extensions": {
          "putio": {
            "cssName": "tracking-normal",
            "mode": "global",
            "figma": true
          }
        }
      },
      "wide": {
        "$type": "dimension",
        "$value": "0.02em",
        "$extensions": {
          "putio": {
            "cssName": "tracking-wide",
            "mode": "global",
            "figma": true
          }
