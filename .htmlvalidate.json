{
  "extends": ["html-validate:recommended"],
  "elements": ["html5"],
  "rules": {
    "attr-case": "error",
    "attr-quotes": "error",
    "doctype-html": "error",
    "no-dup-attr": "error",
    "no-implicit-button-type": "off",
    "no-implicit-input-type": "off",
    "no-inline-style": "off",
    "no-raw-characters": "off",
    "no-trailing-whitespace": "off",
    "element-permitted-content": "off",
    "element-required-attributes": "off",
    "element-required-content": "off",
    "heading-level": "off",
    "prefer-native-element": "off",
    "require-sri": "off",
    "text-content": "off",
    "valid-id": "error",
    "void-style": "off",
    "autocomplete-password": "off",
    "wcag/h30": "off",
    "wcag/h32": "off",
    "wcag/h36": "off",
    "wcag/h37": "off"
  }
}
